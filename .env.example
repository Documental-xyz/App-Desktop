# GitHub Device Flow Configuration
# Copy this file to .env and fill in your actual values

# Get Client ID from: https://github.com/settings/applications/new
# Note: Client Secret is NOT needed for Device Flow
GITHUB_CLIENT_ID=your_github_client_id_here

# Theme Configuration
# THEME=base              # Theme name (must match directory in themes/)
# THEME_MODE=auto         # dark | light | auto (auto follows OS preference)

# Git Provider Configuration
# isomorphic-git (pure JS, default) | dugite (libgit2 native bindings)
GIT_PROVIDER=isomorphic-git